        :root {
            --bg-color: #0a0a0a;
            --card-bg: #161616;
            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --accent-gradient: linear-gradient(45deg, #7928CA, #FF0080);
            --accent-color-solid: #FF0080;
            --font-stack: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-display: 'Bebas Neue', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; cursor: none; }
        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-color);
            color: var(--text-primary);
            font-family: var(--font-stack);
            line-height: 1.6;
            padding: 2rem;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            background: url('data:image/svg+xml;base64,');
            opacity: 0.15;
            z-index: 9999;
        }

        .cursor {
            width: 20px; height: 20px;
            border: 1px solid var(--text-primary);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 10000;
            transition: transform 0.1s ease, background 0.3s ease;
            mix-blend-mode: difference;
        }
        .cursor.grow { transform: scale(2.5); background: var(--text-primary); border: none; }

        a:focus-visible, button:focus-visible {
            outline: 3px solid var(--accent-color-solid);
            outline-offset: 4px;
            border-radius: 4px;
        }

        .container { max-width: 900px; margin: 0 auto; }

        h1 {
            font-family: var(--font-display);
            font-size: 6rem;
            letter-spacing: 2px;
            margin-bottom: 1rem;
            line-height: 1;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
            animation: slideInLeft 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
        }

        .hero-sub { animation: fadeIn 0.8s ease-in 0.4s both; }

        @keyframes slideInLeft {
            from { transform: translateX(-100px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h2 {
            font-family: var(--font-display);
            font-size: 3rem;
            letter-spacing: 2px;
            margin-bottom: 2.5rem;
            display: flex;
            align-items: center;
        }
        h2::after {
            content: "";
            flex: 1;
            height: 2px;
            background: #333;
            margin-left: 1.5rem;
        }

        p.lead { font-size: 1.4rem; font-weight: 600; margin-bottom: 2rem; }
        .text-secondary { color: var(--text-secondary); font-size: 1.1rem; }

        .inline-link {
            color: var(--text-primary);
            text-decoration: none;
            border-bottom: 2px solid var(--accent-color-solid);
            padding-bottom: 2px;
            transition: all 0.3s ease;
        }
        .inline-link:hover {
            box-shadow: inset 0 -20px 0 var(--accent-color-solid);
            color: white;
            border-color: transparent;
        }

        section { margin-bottom: 8rem; }

        /* --- Stack --- */
        .stack-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }
        .skill-block {
            background: var(--card-bg);
            padding: 2rem;
            border-radius: 16px;
            border: 1px solid #252525;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .skill-block:hover {
            transform: translateY(-8px) scale(1.02);
            border-color: var(--accent-color-solid);
            box-shadow: 0 10px 30px -10px rgba(255, 0, 128, 0.3);
        }
        .skill-category-title {
            display: block;
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 1rem;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .skill-pill {
            display: inline-block;
            background: #252525;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-weight: 600;
            margin: 0.25rem;
            font-size: 0.85rem;
        }

        /* --- Experience Timeline --- */
        .timeline { position: relative; padding-left: 2rem; }
        .timeline::before {
            content: "";
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 2px;
            background: linear-gradient(to bottom, #7928CA, #FF0080, #252525);
        }
        .timeline-item {
            position: relative;
            margin-bottom: 3.5rem;
            padding: 2rem;
            background: var(--card-bg);
            border-radius: 16px;
            border: 1px solid #252525;
            transition: border-color 0.3s ease;
        }
        .timeline-item:hover { border-color: #444; }
        .timeline-item::before {
            content: "";
            position: absolute;
            left: -2.55rem;
            top: 2rem;
            width: 12px; height: 12px;
            border-radius: 50%;
            background: var(--accent-gradient);
            border: 2px solid var(--bg-color);
        }
        .timeline-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .timeline-header h3 {
            font-size: 1.3rem;
            font-weight: 800;
        }
        .timeline-date {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--accent-color-solid);
            background: rgba(255,0,128,0.1);
            padding: 0.3rem 0.8rem;
            border-radius: 50px;
            white-space: nowrap;
        }
        .timeline-company {
            font-size: 1rem;
            color: var(--text-secondary);
            margin-bottom: 1rem;
            font-weight: 500;
        }
        .timeline-bullets {
            list-style: none;
            padding: 0;
        }
        .timeline-bullets li {
            position: relative;
            padding-left: 1.2rem;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }
        .timeline-bullets li::before {
            content: "→";
            position: absolute;
            left: 0;
            color: var(--accent-color-solid);
        }

        /* --- Project Cards --- */
        .project-card {
            background-color: var(--card-bg);
            border-radius: 24px;
            overflow: hidden;
            margin-bottom: 4rem;
            border: 1px solid #252525;
            transition: all 0.4s ease;
