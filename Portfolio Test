        .contact-link-item a::after {
            content: "●";
            position: absolute;
            font-size: 1rem;
            color: var(--accent-color-solid);
            top: -10px; right: -15px;
            opacity: 0;
            transition: all 0.3s ease;
        }
        .contact-link-item a:hover::after {
